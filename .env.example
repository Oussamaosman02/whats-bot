# ── Database (Neon Postgres) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── AI (Gemini via OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Any google/gemini-* model on OpenRouter. Default: google/gemini-2.5-flash-lite
GEMINI_MODEL=google/gemini-2.5-flash-lite

# ── Zernio (official Cloud API for 1:1 / templates) ─────────────────────────
ZERNIO_API_KEY=...
# Optional: pin the WhatsApp account id (otherwise auto-detected from /v1/accounts)
ZERNIO_WHATSAPP_ACCOUNT_ID=
# Optional: HMAC secret you set when registering the webhook (POST /api/zernio/webhooks)
ZERNIO_WEBHOOK_SECRET=

# ── This API ─────────────────────────────────────────────────────────────────
# Public URL of this app (used to build webhook URLs when registering with Zernio)
APP_URL=http://localhost:3000
# Bearer token required on every /api/* route except webhooks & health (leave empty to disable auth in local dev)
API_KEY=
# Password for browser access (HTTP Basic auth, any username) to the landing page, /api index, health details and the QR page.
# Falls back to API_KEY when empty. Webhooks are never password-protected.
DASHBOARD_PASSWORD=
# Start the WhatsApp (Baileys) connection automatically when the server boots. Set to false to start via POST /api/whatsapp/connect
WHATSAPP_AUTOSTART=true

# ── Bot behaviour ────────────────────────────────────────────────────────────
BOT_NAME=ResumenBot
BOT_LANGUAGE=es
BOT_COMMAND_PREFIX=/
# IANA timezone used to interpret "ayer 15:00", "08/09 10:30", etc.
BOT_TIMEZONE=Europe/Madrid
# Where DM replies go: "baileys" (linked device) or "zernio" (official Cloud API)
DM_TRANSPORT=baileys
# Max messages fed into one summary (1500 msgs ≈ 40k tokens ≈ $0.004 on gemini-2.5-flash-lite)
SUMMARY_MAX_MESSAGES=1500
# /preguntar: keyword matches over the WHOLE history (+ neighbours) plus the most recent messages, capped by chars
ASK_MAX_CHARS=400000
# Model for /preguntar (needs good instruction-following to consolidate many hits); summaries use GEMINI_MODEL
ASK_MODEL=google/gemini-2.5-flash
# Hard cap on bullets in an answer
ASK_MAX_BULLETS=14
# Assistant mode: "@bot haz un audio diciendo…", "@bot resume desde ayer", "@bot manda un sticker de risa" (groups only)
ASSISTANT_ENABLED=true
# Gemini model for the assistant (needs tool calling; default: ASK_MODEL)
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=20
# Max voice notes the assistant produces per user per day (ADMIN_PHONES exempt)
ASSISTANT_AUDIO_DAILY_LIMIT=3
ASSISTANT_CONTEXT_MESSAGES=30
ASK_KEYWORD_HITS=300
ASK_RECENT_MESSAGES=200
# Transcribe voice notes / audio with Gemini so they appear in summaries (true|false)
TRANSCRIBE_AUDIO=true
# Skip audios longer than this (seconds)
TRANSCRIBE_MAX_SECONDS=900
# Optional: a different google/gemini-* model for transcription (default: GEMINI_MODEL)
TRANSCRIBE_MODEL=
# Describe stickers, photos and video thumbnails with Gemini vision (cached per file hash). WhatsApp's own accessibility labels are used first when present.
DESCRIBE_MEDIA=true

# ── Voice notes out (ElevenLabs text-to-speech, optional) ───────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_SECONDARY_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Longest text turned into one voice note (characters are what ElevenLabs bills)
TTS_MAX_CHARS=2500

# ── Cloudflare R2 (object storage for stickers & media; keeps the DB small) ──
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_S3_API_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional public bucket URL (r2.dev or custom domain); otherwise presigned URLs are used
CLOUDFLARE_S3_API_PUBLIC_ENDPOINT=
CLOUDFLARE_S3_ACCESS_KEY=
CLOUDFLARE_S3_SECRET_KEY=
# Keep received audio/images/videos (≤ MB) in R2 so /transcribir, media download and /sticker work after restarts
MEDIA_ARCHIVE=true
MEDIA_ARCHIVE_MAX_MB=15

# ── Retention & alerts ───────────────────────────────────────────────────────
# Messages, summaries and webhook events older than this are deleted (hourly job + POST /api/maintenance/retention)
RETENTION_DAYS=15
# Before deleting a day of messages, write an archive summary of it (kept forever, used as older context)
RETENTION_ARCHIVE=true
# Max /resumen per user per day (admins exempt)
DAILY_SUMMARY_LIMIT=3
# Phone (with country code) that receives operational alerts via Zernio when WhatsApp disconnects / logs out / recovers
ALERT_PHONE=34600000000
# Approved Zernio/Meta UTILITY template used for alerts (4 positional params: bot name, message, status, time).
# Without it, alerts are sent as free text, which only works inside the 24h window.
ALERT_TEMPLATE_NAME=bot_alert
ALERT_TEMPLATE_LANGUAGE=es
ALERT_COOLDOWN_MINUTES=30
# Imported chat history is kept forever unless this is true
RETENTION_INCLUDE_IMPORTS=false

# ── Admin / chat import ──────────────────────────────────────────────────────
# Phones allowed to run admin commands (e.g. the hidden /importar). Defaults to ALERT_PHONE.
ADMIN_PHONES=34600000000
# Max size of an export file accepted via WhatsApp DM (zip or txt). Bigger → use POST /api/groups/:jid/import
IMPORT_MAX_MB=200
# How to read dates in exports: auto (detect), dmy (Spain), mdy (US)
IMPORT_DATE_FORMAT=auto

# ── Meta Cloud API Groups (Path A, optional, needs a Cloud-API-only number) ──
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=debug
# pretty (human, colours) | json (machine)   – defaults to pretty outside production
LOG_FORMAT=pretty
